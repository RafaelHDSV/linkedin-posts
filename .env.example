# Supabase (PostgreSQL) — cache de perfis e posts
# URL do projeto: Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (somente no backend; NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Chave usada para autenticar os clientes da API (header x-api-key)
API_KEY=troque-por-uma-chave-forte

# Token para proteger /api/cron/scrape (obrigatorio na Vercel)
CRON_SECRET=troque-por-um-token-longo-aleatorio

# Porta do servidor HTTP da API (somente yarn dev / yarn start local)
PORT=3333

# Intervalo padrao de coleta por perfil, em horas
SCRAPE_INTERVAL_HOURS=6

# Quantos perfis podem ser coletados em paralelo (mantenha baixo para reduzir risco de bloqueio)
SCRAPE_CONCURRENCY=1

# --- Sessao LinkedIn ---
# Gerada por yarn auth:login (login MANUAL — 2FA no navegador).
# Não há relogin automático na expiração; na Vercel use session:upload após renovar.
# local = arquivo no disco (dev). supabase = Supabase Storage (Vercel/producao).
SESSION_STORAGE_PROVIDER=local
# Arquivo gerado por yarn auth:login (ambiente local)
SESSION_LOCAL_PATH=storage/session.json
# Perfil coletado automaticamente quando a sessão expirar no logon do Windows
SCRAPE_USERNAME=rafael-vieira1720
# Bucket privado no Supabase Storage (quando provider=supabase)
SESSION_STORAGE_BUCKET=linkedin-posts-private
# Caminho do objeto no bucket
SESSION_REMOTE_PATH=session/session.json

# false = Chromium visivel nas coletas (se headless falhar com sessao valida)
# SCRAPE_HEADLESS=false

# Nivel de log (debug | info | warn | error)
LOG_LEVEL=info
