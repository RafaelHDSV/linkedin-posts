# =============================================================================
# linkedin-posts — copie para .env e preencha (NUNCA commite o .env)
#   cp .env.example .env
# =============================================================================

# --- Supabase (obrigatório) ---
# Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Project Settings → API → service_role (somente backend / este CLI)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- API local opcional (yarn dev) ---
# Header x-api-key nas rotas /profiles
API_KEY=troque-por-uma-chave-forte

# Porta HTTP da API local
PORT=3333

# Usado só pelo cron interno (yarn dev). No fluxo scrape/on-logon não é crítico.
SCRAPE_INTERVAL_HOURS=6
SCRAPE_CONCURRENCY=1

# Token do cron serverless (só se usar deploy Vercel legado — não é o caminho feliz)
# CRON_SECRET=troque-por-um-token-longo-aleatorio

# --- Sessão LinkedIn ---
# Gerada por: yarn auth:login (manual, com 2FA no navegador)
SESSION_STORAGE_PROVIDER=local
SESSION_LOCAL_PATH=storage/session.json

# Username do perfil a coletar no logon (slug de linkedin.com/in/<este-valor>/)
SCRAPE_USERNAME=seu-username-linkedin

# Só necessário se SESSION_STORAGE_PROVIDER=supabase (caminho legado / nuvem)
# SESSION_STORAGE_BUCKET=linkedin-posts-private
# SESSION_REMOTE_PATH=session/session.json

# Descomente para ver o Chromium nas coletas (debug)
# SCRAPE_HEADLESS=false

LOG_LEVEL=info
