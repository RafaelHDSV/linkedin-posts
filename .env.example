# Supabase (PostgreSQL) — cache de perfis e posts
# URL do projeto: Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave service_role (somente no backend; NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Chave usada para autenticar os clientes da API (header x-api-key)
API_KEY=troque-por-uma-chave-forte

# Porta do servidor HTTP da API
PORT=3333

# Intervalo padrao de coleta por perfil, em horas
SCRAPE_INTERVAL_HOURS=6

# Quantos perfis podem ser coletados em paralelo (mantenha baixo para reduzir risco de bloqueio)
SCRAPE_CONCURRENCY=1

# Caminho do arquivo de sessao autenticada do LinkedIn (gerado por `yarn auth:login`)
SESSION_STORAGE_PATH=storage/session.json

# false = Chromium visivel nas coletas (se headless falhar com sessao valida)
# SCRAPE_HEADLESS=false

# Nivel de log (debug | info | warn | error)
LOG_LEVEL=info
