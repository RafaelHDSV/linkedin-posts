{
  "name": "linkedin-posts",
  "version": "1.0.0",
  "description": "Coleta local de posts públicos do LinkedIn (Playwright) com cache no Supabase para consumo em sites/portfólios.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "auth:login": "tsx src/cli/authLogin.ts",
    "session:upload": "tsx src/cli/sessionUpload.ts",
    "scrape": "tsx src/cli/scrapeProfile.ts",
    "scrape:on-logon": "tsx src/cli/scrapeOnLogon.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sparticuz/chromium": "^133.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "linkedom": "^0.18.9",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@vercel/node": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
